# Configurações de Produção - SaborFit API
# Copie este arquivo para .env.production e configure os valores reais

# Servidor
PORT=3000
NODE_ENV=production

# MySQL (Produção)
DB_HOST=seu-host-mysql-producao
DB_PORT=3306
DB_NAME=saborfit_prod_db
DB_USER=seu-usuario-mysql
DB_PASSWORD=sua-senha-mysql-forte
DB_CONNECTION_LIMIT=20

# JWT (CRÍTICO: Use segredo forte e aleatório, mínimo 32 caracteres)
# Gere um novo segredo com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SEU_JWT_SECRET_ALEATORIO_DE_NO_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=7d

# Segurança
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_HOURS=1

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20

# Email Service (Configure conforme seu provedor)
EMAIL_SERVICE=ses
# AWS SES
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua-aws-access-key
AWS_SECRET_ACCESS_KEY=sua-aws-secret-key
EMAIL_FROM=noreply@saborfit.com

# Ou SendGrid
# SENDGRID_API_KEY=sua-sendgrid-api-key
# EMAIL_FROM=noreply@saborfit.com

# Ou SMTP genérico
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_USER=seu-email
# SMTP_PASS=sua-senha
# EMAIL_FROM=noreply@saborfit.com

# Monitoramento (Opcional)
SENTRY_DSN=seu-sentry-dsn
LOG_LEVEL=info
