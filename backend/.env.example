PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saborfit_db
DB_USER=root
DB_PASSWORD=SUA_SENHA
DB_CONNECTION_LIMIT=10

# JWT (Mínimo 32 caracteres, use segredo forte e aleatório em produção)
JWT_SECRET=altere_para_um_segredo_longo_e_aleatorio_com_no_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# Segurança
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_HOURS=1

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20
